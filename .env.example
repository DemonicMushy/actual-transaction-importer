# Copy these into your shell environment (or source a private .env file).
ACTUAL_SERVER_URL=https://actual.example.com
ACTUAL_PASSWORD=replace-me
ACTUAL_SYNC_ID=00000000-0000-0000-0000-000000000000

# Set either the account ID or its exact name. Input-file values override these.
ACTUAL_ACCOUNT_NAME=My Credit Card
# ACTUAL_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# Only needed when end-to-end encryption is enabled for the budget.
# ACTUAL_BUDGET_PASSWORD=replace-me

# Optional; defaults to .actual-cache in the current directory.
# ACTUAL_DATA_DIR=/var/lib/actual-importer

# Optional when python3 is not on PATH or uses a different environment.
# PYTHON=/absolute/path/to/python3
